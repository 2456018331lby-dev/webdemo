{
  "manifest_version": 3,
  "name": "Job Application Assistant",
  "description": "本地优先的求职岗位评分、队列和安全投递助手。",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting", "alarms"],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "https://*.lagou.com/*",
    "https://*.liepin.com/*",
    "https://*.linkedin.com/*",
    "https://*.bing.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Job Assistant",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.lagou.com/*",
        "https://*.liepin.com/*",
        "https://*.linkedin.com/*",
        "https://*.bing.com/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
